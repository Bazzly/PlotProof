# Optional: only needed once a Supabase project exists. Without these,
# uploaded files are stored locally under data/uploads/.
SUPABASE_URL=
SUPABASE_KEY=

# Optional but strongly recommended: enables vision-based coordinate
# extraction for photographed survey plans (utils/vision_extract.py).
# Tesseract OCR reliably fails on real phone photos with mixed text
# orientation - this fixes that, at a real per-image cost (roughly
# $0.05-0.08/image on Claude Opus 4.8 at 2026 pricing). Without this set,
# image uploads fall back to the free local OCR pipeline, which will
# under-read many real-world photos. PDF uploads are unaffected either way.
#
# This repo is public, so don't commit a real key here. A key set via the
# admin portal (pages/admin_review.py, gated behind ADMIN_PASSWORD below)
# always overrides this env var and takes effect immediately - use that to
# rotate a leaked/exposed key without needing redeploy access.
ANTHROPIC_API_KEY=

# Optional: daily per-visitor caps and burst protection (utils/rate_limit.py),
# defaults shown. DAILY_CHECK_LIMIT caps "Analyze My Land"/"Compare Plots"
# clicks - the core app usage. DAILY_VISION_LIMIT caps the vision extraction
# API call specifically (a visitor over this cap silently falls back to free
# OCR rather than being blocked). BURST_MAX_REQUESTS/BURST_WINDOW_SECONDS
# guard against rapid automated hammering within those daily allowances.
DAILY_CHECK_LIMIT=3
DAILY_VISION_LIMIT=5
BURST_MAX_REQUESTS=10
BURST_WINDOW_SECONDS=60

# Optional: override the consultation CTA links.
WHATSAPP_LINK=https://chat.whatsapp.com/KrMfFgenA5u50QTASfyyro?s=cl&p=a&ilr=1
CALENDLY_LINK=https://calendly.com/bazeet4love

# Optional: shown when asking a user to get their coordinate system
# confirmed by us directly (see show_crs_disclaimer() in app.py).
TWITTER_LINK=https://x.com/bazzlycodes

# Optional: the live app's URL, used in the "share with your neighbors" CTA.
APP_URL=https://plotproof.streamlit.app

# Required before real launch: the contact address shown in the Privacy
# Policy for data-rights requests (access/correction/deletion). Without
# this set, the policy honestly discloses that it isn't configured yet -
# don't ship to real users until it is.
PRIVACY_CONTACT_EMAIL=

# Required to use the admin extraction-review portal (pages/admin_review.py).
# Without this set, that page refuses to render at all rather than being
# left open with no gate.
ADMIN_PASSWORD=
